<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>College Website</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Times New Roman", Times, serif; color: #000; }

  .banner {
    background: linear-gradient(to right, #f6dbe8 40%, #eeeeee 100%);
    padding: 16px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .banner-left { display: flex; align-items: center; gap: 14px; }

  .logo-diamond {
    width: 70px;
    height: 70px;
    background-color: #ffffff;
    border: 3px solid #2b2b8f;
    transform: rotate(45deg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .logo-diamond span {
    transform: rotate(-45deg);
    font-size: 10px;
    font-weight: bold;
    color: #2b2b8f;
    text-align: center;
  }

  .college-name h1 {
    font-size: 24px;
    color: #2b2b8f;
    font-weight: bold;
  }

  .kcw-logo {
    text-align: center;
    font-size: 20px;
    font-weight: bold;
    background: linear-gradient(to right, red, orange, yellow, green, blue, indigo);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .kcw-caption {
    font-size: 8px;
    text-align: center;
    color: #444;
  }

  .subtitle {
    text-align: center;
    font-size: 14px;
    padding: 6px 0;
  }

  hr.thick { border: none; border-top: 2px solid #2b2b8f; margin: 0; }

  .content { padding: 24px 30px 10px; min-height: 260px; }

  .content h2 {
    color: #2b2b8f;
    font-size: 22px;
    margin-bottom: 16px;
  }

  .content ol { padding-left: 20px; font-size: 16px; line-height: 1.9; }
  .content ol > li { margin-bottom: 6px; }
  .content ul { list-style-type: circle; padding-left: 30px; font-size: 15px; }
  .content ul li a { color: #1a1aff; text-decoration: underline; cursor: pointer; }

  .page { display: none; }
  .page.active { display: block; }

  .home-link {
    text-align: center;
    padding: 10px 0;
    border-top: 1px solid #ccc;
    margin-top: 20px;
  }
  .home-link a { color: #1a1aff; text-decoration: underline; font-size: 14px; cursor: pointer; }

  .date-stamp {
    text-align: right;
    font-size: 11px;
    color: #666;
    padding: 4px 30px 16px;
  }
</style>
</head>
<body>

  <div class="banner">
    <div class="banner-left">
      <div class="logo-diamond"><span>PSGR<br>KRC</span></div>
      <div class="college-name">
        <h1>PSGR<br>Krishnammal College for Women</h1>
      </div>
    </div>
    <div>
      <div class="kcw-logo">KCW</div>
      <div class="kcw-caption">CELEBRATING WOMEN<br>SINCE 1963</div>
    </div>
  </div>

  <div class="subtitle">(Autonomous College)</div>
  <hr class="thick">

  <!-- ================= HOME PAGE ================= -->
  <div class="page active" id="home">
    <div class="content">
      <ol>
        <li>
          courses offered
          <ul>
            <li><a class="nav-link" data-page="ug">UG</a></li>
            <li><a class="nav-link" data-page="pg">PG</a></li>
          </ul>
        </li>
        <li>contact us: T-422 429 5959</li>
        <li>infrastructure</li>
      </ol>
    </div>
  </div>

  <!-- ================= UG PAGE ================= -->
  <div class="page" id="ug">
    <div class="content">
      <h2>UG COURSES OFFERED:</h2>
      <ol>
        <li>
          B.com
          <ul>
            <li>B.com CA</li>
            <li>B.com PA</li>
            <li>B.com BA</li>
          </ul>
        </li>
        <li>
          BBA
          <ul>
            <li>BBA BPM</li>
            <li>BBA BM</li>
          </ul>
        </li>
        <li>
          B.SC
          <ul>
            <li>B.SC PHY</li>
            <li>B.SC MATHS</li>
            <li>B.SC CHEMISTRY</li>
          </ul>
        </li>
      </ol>
    </div>
    <div class="home-link">
      <a class="nav-link" data-page="home">home</a>
    </div>
  </div>

  <!-- ================= PG PAGE ================= -->
  <div class="page" id="pg">
    <div class="content">
      <ol>
        <li>
          PG courses offered
          <ul>
            <li>M.Com</li>
            <li>MCA</li>
            <li>M.SC</li>
            <li>MBA</li>
            <li>MA</li>
          </ul>
        </li>
      </ol>
    </div>
    <div class="home-link">
      <a class="nav-link" data-page="home">home</a>
    </div>
    <div class="date-stamp" id="date-stamp"></div>
  </div>

  <script>
    const links = document.querySelectorAll('.nav-link');
    const pages = document.querySelectorAll('.page');

    links.forEach(function (link) {
      link.addEventListener('click', function () {
        const targetId = link.getAttribute('data-page');
        pages.forEach(function (page) {
          page.classList.toggle('active', page.id === targetId);
        });
      });
    });

    const stamp = document.getElementById('date-stamp');
    const today = new Date();
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    stamp.textContent = today.toLocaleDateString('en-US', options);
  </script>

</body>
</html>
