<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>advertisement.html</title>
<style>
  body {
    font-family: "Times New Roman", Times, serif;
    text-align: center;
    padding: 30px 20px;
    color: #000;
  }

  h1 {
    font-size: 26px;
    margin-bottom: 10px;
  }

  hr {
    width: 80%;
    margin: 0 auto 20px;
  }

  .tagline {
    font-size: 18px;
    margin-bottom: 20px;
  }

  .highlight {
    background-color: yellow;
    padding: 2px 6px;
    font-weight: bold;
  }

  /* ---------- CSS drawn coffee cup image ---------- */
  .cup-wrap {
    margin: 20px auto;
    width: 140px;
  }
  .cup {
    width: 100px;
    height: 90px;
    background-color: #ffffff;
    border: 4px solid #4b2e2b;
    border-radius: 0 0 40px 40px;
    margin: 0 auto;
    position: relative;
  }
  .coffee {
    width: 92px;
    height: 30px;
    background-color: #6f4e37;
    border-radius: 0 0 0 0;
    position: absolute;
    top: 4px;
    left: 4px;
  }
  .handle {
    width: 24px;
    height: 34px;
    border: 6px solid #4b2e2b;
    border-left: none;
    border-radius: 0 20px 20px 0;
    position: absolute;
    top: 20px;
    right: -26px;
  }
  .steam {
    font-size: 20px;
    color: #999;
    margin-bottom: -6px;
  }

  ul {
    display: inline-block;
    text-align: left;
    font-size: 17px;
    font-weight: bold;
    line-height: 1.8;
    margin: 20px 0;
  }

  .footer-line {
    font-size: 20px;
    background-color: yellow;
    display: inline-block;
    padding: 4px 12px;
    font-weight: bold;
    margin-bottom: 20px;
  }

  .address {
    text-align: left;
    font-size: 14px;
    border-top: 1px solid #999;
    padding-top: 10px;
    margin-top: 20px;
  }
  .address u {
    font-weight: bold;
  }

  .phone {
    font-size: 20px;
    font-weight: bold;
    border-top: 1px solid #999;
    padding: 14px 0 4px;
  }
</style>
</head>
<body>

  <h1>THE COFFEE CORNER</h1>
  <hr>

  <p class="tagline">
    Freshly Brewed Daily <span class="highlight">"Wake Up To The Best Cup In Town"</span>
  </p>

  <div class="cup-wrap">
    <div class="steam">~ ~ ~</div>
    <div class="cup">
      <div class="coffee"></div>
      <div class="handle"></div>
    </div>
  </div>

  <ul>
    <li>&#9702; Freshly Roasted Coffee Beans</li>
    <li>&#9702; Espresso, Latte &amp; Cappuccino</li>
    <li>&#9702; Fresh Bakery Items Daily</li>
    <li>&#9702; Free Wi-Fi for Customers</li>
    <li>&#9702; Cozy Seating &amp; Study Corner</li>
    <li>&#9702; Loyalty Card Rewards</li>
    <li>&#9702; STUDENT DISCOUNTS AVAILABLE</li>
    <li>&#9702; OPEN 7 DAYS A WEEK</li>
  </ul>

  <br>
  <p class="footer-line">Freshest Brews in Town</p>

  <div class="address">
    <u>Address:</u><br>
    24 Lake View Road, Coimbatore &nbsp; http://www.thecoffeecorner.net
  </div>

  <div class="phone">
    PHONE NO: 0422-555-0199
  </div>

</body>
</html>
