<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>
</head>

<body>

<h1>STUDENT REGISTRATION FORM</h1>

<form>

<h2>Personal Details</h2>

<label>Full Name:</label>
<input type="text" name="fullname"><br><br>

<label>Register Number:</label>
<input type="text" name="regno"><br><br>

<label>Email:</label>
<input type="email" name="email"><br><br>

<label>Mobile Number:</label>
<input type="tel" name="mobile"><br><br>

<label>Date of Birth:</label>
<input type="date" name="dob"><br><br>

<label>Gender:</label>
<input type="radio" name="gender"> Male
<input type="radio" name="gender"> Female
<input type="radio" name="gender"> Other
<br><br>

<label>Address:</label><br>
<textarea rows="5" cols="50"></textarea>
<br><br>

<h2>Course Details</h2>

<label>Course Applied For:</label><br>

<input type="checkbox"> B.Sc Computer Science<br>
<input type="checkbox"> B.Sc Biotechnology<br>
<input type="checkbox"> BCA<br>
<input type="checkbox"> B.Com<br>
<input type="checkbox"> BBA<br>
<input type="checkbox"> B.Sc Mathematics<br><br>

<label>Year of Study:</label><br>

<input type="radio" name="year"> First Year<br>
<input type="radio" name="year"> Second Year<br>
<input type="radio" name="year"> Third Year<br><br>

<label>Department:</label>

<select>
<option>--Select Department--</option>
<option>Computer Science</option>
<option>Biotechnology</option>
<option>Commerce</option>
<option>Mathematics</option>
<option>Physics</option>
<option>Chemistry</option>
</select>

<br><br>

<label>Upload Passport Size Photo:</label>

<input type="file">

<br><br>

<h2>Account Details</h2>

<label>Username:</label>
<input type="text">
<br><br>

<label>Password:</label>
<input type="password">
<br><br>

<label>Confirm Password:</label>
<input type="password">
<br><br>

<input type="checkbox">
I accept the Terms and Conditions.

<br><br>

<input type="submit" value="Submit">

<input type="reset" value="Reset">

<input type="button" value="Help">

</form>

</body>
</html>
