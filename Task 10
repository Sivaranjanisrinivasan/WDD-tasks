<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Form Validation</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f4f4;
    margin: 0;
    padding: 40px 16px;
  }
  .form-card {
    background: #ffffff;
    max-width: 420px;
    margin: 0 auto;
    padding: 26px 30px 32px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  h2 {
    text-align: center;
    color: #1a1aff;
    margin: 0 0 24px;
    font-size: 22px;
  }
  .field { margin-bottom: 16px; }
  label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 5px;
    color: #333;
  }
  input[type="text"],
  input[type="email"],
  input[type="password"],
  input[type="tel"] {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid #bbb;
    border-radius: 4px;
    font-size: 14px;
  }
  input.invalid { border-color: #c0392b; }
  input.valid { border-color: #2e8b3d; }

  .error-text {
    color: #c0392b;
    font-size: 12px;
    margin-top: 4px;
    min-height: 14px;
  }

  button {
    width: 100%;
    background-color: #2e8b3d;
    color: #fff;
    border: none;
    padding: 11px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 8px;
  }
  button:hover { background-color: #256b30; }

  .success-msg {
    display: none;
    background-color: #eaf7ec;
    color: #256b30;
    border: 1px solid #2e8b3d;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 13px;
    margin-top: 16px;
    text-align: center;
  }
</style>
</head>
<body>

<div class="form-card">
  <h2>Registration Form</h2>

  <form id="reg-form" novalidate>

    <div class="field">
      <label for="fullname">Full Name</label>
      <input type="text" id="fullname" placeholder="Enter your full name">
      <div class="error-text" id="err-fullname"></div>
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" placeholder="Enter your email">
      <div class="error-text" id="err-email"></div>
    </div>

    <div class="field">
      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" placeholder="10 digit phone number">
      <div class="error-text" id="err-phone"></div>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" placeholder="Minimum 6 characters">
      <div class="error-text" id="err-password"></div>
    </div>

    <div class="field">
      <label for="confirm-password">Confirm Password</label>
      <input type="password" id="confirm-password" placeholder="Re-enter password">
      <div class="error-text" id="err-confirm-password"></div>
    </div>

    <button type="submit">Register</button>

    <div class="success-msg" id="success-msg">Registration successful!</div>

  </form>
</div>

<script>
  const form = document.getElementById('reg-form');

  const fullname = document.getElementById('fullname');
  const email = document.getElementById('email');
  const phone = document.getElementById('phone');
  const password = document.getElementById('password');
  const confirmPassword = document.getElementById('confirm-password');
  const successMsg = document.getElementById('success-msg');

  function setError(input, errorId, message) {
    document.getElementById(errorId).textContent = message;
    input.classList.remove('valid');
    input.classList.add('invalid');
  }

  function setValid(input, errorId) {
    document.getElementById(errorId).textContent = "";
    input.classList.remove('invalid');
    input.classList.add('valid');
  }

  function validateFullname() {
    const value = fullname.value.trim();
    if (value === "") {
      setError(fullname, 'err-fullname', "Full name is required.");
      return false;
    }
    if (value.length < 3) {
      setError(fullname, 'err-fullname', "Name must be at least 3 characters.");
      return false;
    }
    setValid(fullname, 'err-fullname');
    return true;
  }

  function validateEmail() {
    const value = email.value.trim();
    const pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (value === "") {
      setError(email, 'err-email', "Email is required.");
      return false;
    }
    if (!pattern.test(value)) {
      setError(email, 'err-email', "Enter a valid email address.");
      return false;
    }
    setValid(email, 'err-email');
    return true;
  }

  function validatePhone() {
    const value = phone.value.trim();
    const pattern = /^[0-9]{10}$/;
    if (value === "") {
      setError(phone, 'err-phone', "Phone number is required.");
      return false;
    }
    if (!pattern.test(value)) {
      setError(phone, 'err-phone', "Enter a valid 10 digit phone number.");
      return false;
    }
    setValid(phone, 'err-phone');
    return true;
  }

  function validatePassword() {
    const value = password.value;
    if (value === "") {
      setError(password, 'err-password', "Password is required.");
      return false;
    }
    if (value.length < 6) {
      setError(password, 'err-password', "Password must be at least 6 characters.");
      return false;
    }
    setValid(password, 'err-password');
    return true;
  }

  function validateConfirmPassword() {
    const value = confirmPassword.value;
    if (value === "") {
      setError(confirmPassword, 'err-confirm-password', "Please confirm your password.");
      return false;
    }
    if (value !== password.value) {
      setError(confirmPassword, 'err-confirm-password', "Passwords do not match.");
      return false;
    }
    setValid(confirmPassword, 'err-confirm-password');
    return true;
  }

  fullname.addEventListener('blur', validateFullname);
  email.addEventListener('blur', validateEmail);
  phone.addEventListener('blur', validatePhone);
  password.addEventListener('blur', validatePassword);
  confirmPassword.addEventListener('blur', validateConfirmPassword);

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    successMsg.style.display = "none";

    const isFullnameValid = validateFullname();
    const isEmailValid = validateEmail();
    const isPhoneValid = validatePhone();
    const isPasswordValid = validatePassword();
    const isConfirmValid = validateConfirmPassword();

    const allValid = isFullnameValid && isEmailValid && isPhoneValid && isPasswordValid && isConfirmValid;

    if (allValid) {
      successMsg.style.display = "block";
      form.reset();
      document.querySelectorAll('input').forEach(function (input) {
        input.classList.remove('valid');
      });
    }
  });
</script>

</body>
</html>
