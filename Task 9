<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frame Based Website</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: Arial, Helvetica, sans-serif;
    height: 100vh;
    display: grid;
    grid-template-rows: 80px 1fr;
    grid-template-columns: 180px 1fr;
    grid-template-areas:
      "header header"
      "nav main";
  }

  /* ---------- Header frame ---------- */
  .header-frame {
    grid-area: header;
    background-color: #2e8b3d;
    color: #ffffff;
    display: flex;
    align-items: center;
    padding: 0 24px;
  }
  .header-frame h1 {
    font-size: 20px;
  }

  /* ---------- Nav frame ---------- */
  .nav-frame {
    grid-area: nav;
    background-color: #f4f4f4;
    padding: 20px 0;
    border-right: 2px solid #ddd;
  }
  .nav-frame ul {
    list-style: none;
  }
  .nav-frame li a {
    display: block;
    padding: 12px 20px;
    color: #333;
    text-decoration: none;
    font-size: 14px;
    border-left: 4px solid transparent;
    cursor: pointer;
  }
  .nav-frame li a:hover,
  .nav-frame li a.active {
    background-color: #e0e0e0;
    border-left: 4px solid #2e8b3d;
  }

  /* ---------- Main content frame ---------- */
  .main-frame {
    grid-area: main;
    padding: 30px;
    overflow-y: auto;
    color: #333;
  }
  .main-frame h2 {
    color: #1a1aff;
    margin-bottom: 14px;
  }
  .main-frame p, .main-frame ul {
    font-size: 14px;
    line-height: 1.7;
  }
  .main-frame ul {
    padding-left: 20px;
  }
  .page { display: none; }
  .page.active { display: block; }
</style>
</head>
<body>

  <!-- Header frame -->
  <div class="header-frame">
    <h1>My Frame Based Website</h1>
  </div>

  <!-- Navigation frame -->
  <div class="nav-frame">
    <ul>
      <li><a class="nav-link active" data-page="home">Home</a></li>
      <li><a class="nav-link" data-page="about">About</a></li>
      <li><a class="nav-link" data-page="services">Services</a></li>
      <li><a class="nav-link" data-page="contact">Contact</a></li>
    </ul>
  </div>

  <!-- Main content frame -->
  <div class="main-frame">

    <div class="page active" id="home">
      <h2>Home</h2>
      <p>
        Welcome to my frame based website. This page is loaded inside the main
        content area, while the header stays fixed at the top and the
        navigation menu stays fixed on the left.
      </p>
    </div>

    <div class="page" id="about">
      <h2>About</h2>
      <p>
        This site demonstrates a frame style layout, where the page is divided
        into a header section, a navigation section, and a main content
        section that changes based on which link is clicked.
      </p>
    </div>

    <div class="page" id="services">
      <h2>Services</h2>
      <ul>
        <li>Web Design</li>
        <li>Web Development</li>
        <li>UI/UX Consulting</li>
        <li>Website Maintenance</li>
      </ul>
    </div>

    <div class="page" id="contact">
      <h2>Contact</h2>
      <p>Email: contact@example.com</p>
      <p>Phone: +91 98765 43210</p>
    </div>

  </div>

  <script>
    const links = document.querySelectorAll('.nav-link');
    const pages = document.querySelectorAll('.page');

    links.forEach(function (link) {
      link.addEventListener('click', function () {
        // update active link styling
        links.forEach(function (l) { l.classList.remove('active'); });
        link.classList.add('active');

        // show matching page, hide others
        const targetId = link.getAttribute('data-page');
        pages.forEach(function (page) {
          page.classList.toggle('active', page.id === targetId);
        });
      });
    });
  </script>

</body>
</html>
