<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Class Timetable</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: "Times New Roman", Times, serif;
    background-color: #bfe8fb;
    text-align: center;
    padding: 30px 20px;
    margin: 0;
  }

  h1 {
    color: #b03a9e;
    font-size: 30px;
    margin-bottom: 4px;
  }

  hr {
    border: none;
    border-top: 1px solid #999;
    margin: 20px auto 24px;
    width: 96%;
  }

  h2 {
    color: #1a1aff;
    font-size: 22px;
    text-decoration: underline;
    margin-bottom: 16px;
  }

  .class-tag {
    display: inline-block;
    border: 2px solid #7a1f3d;
    font-weight: bold;
    font-size: 15px;
    padding: 8px 16px;
    margin-bottom: 26px;
    background-color: #ffffff;
  }

  table {
    border-collapse: separate;
    border-spacing: 3px;      /* cell spacing */
    margin: 0 auto;
    border: 3px solid #1b1b3a;
    background-color: #1b1b3a;
    max-width: 1100px;
    width: 100%;
  }

  td, th {
    border: 1px solid #1b1b3a;
    padding: 12px 14px;       /* cell padding */
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    background-color: #eaf6ff;
    color: #111;
  }

  .row-label {
    background-color: #eaf6ff;
    width: 70px;
  }

  .break-cell {
    background-color: #eaf6ff;
    font-weight: bold;
    color: #333;
  }

  /* ---------- Subject colors ---------- */
  .maths   { background-color: #e340e3; color: #fff; }
  .english { background-color: #ff9466; color: #222; }
  .physics { background-color: #7d3cff; color: #fff; }
  .chem    { background-color: #ff4f8b; color: #fff; }
  .lab     { background-color: #4fc3d9; color: #111; }
  .cs      { background-color: #33cc99; color: #111; }
  .pe      { background-color: #8ee000; color: #111; }
  .lib     { background-color: #b39ddb; color: #111; }
</style>
</head>
<body>

  <h1>PSGR COLLEGE OF ARTS &amp; SCIENCE<br>COIMBATORE</h1>
  <hr>

  <h2>DEPARTMENT OF COMPUTER SCIENCE</h2>
  <div class="class-tag">II B.Sc COMPUTER SCIENCE</div>

  <table>
    <tr>
      <th>Time</th>
      <th>9.00-9.50</th>
      <th>9.50-10.40</th>
      <th rowspan="1">10.40-11.00</th>
      <th>11.00-11.50</th>
      <th>11.50-12.40</th>
      <th>1.30-2.20</th>
    </tr>

    <tr>
      <th>D/O</th>
      <th>1</th>
      <th>2</th>
      <th></th>
      <th>3</th>
      <th>4</th>
      <th>5</th>
    </tr>

    <!-- Monday -->
    <tr>
      <td class="row-label">Mon</td>
      <td class="maths">Maths</td>
      <td class="cs">Programming</td>
      <td rowspan="6" class="break-cell">BREAK</td>
      <td class="physics">Physics</td>
      <td class="english">English</td>
      <td colspan="1" class="lab">DBMS Lab</td>
    </tr>

    <!-- Tuesday -->
    <tr>
      <td class="row-label">Tue</td>
      <td colspan="2" class="lab">Programming Lab</td>
      <td class="chem">Chemistry</td>
      <td class="maths">Maths</td>
      <td class="pe">Physical Ed.</td>
    </tr>

    <!-- Wednesday -->
    <tr>
      <td class="row-label">Wed</td>
      <td class="english">English</td>
      <td class="cs">Programming</td>
      <td class="maths">Maths</td>
      <td class="physics">Physics</td>
      <td class="chem">Chemistry</td>
    </tr>

    <!-- Thursday -->
    <tr>
      <td class="row-label">Thu</td>
      <td class="maths">Maths</td>
      <td class="physics">Physics</td>
      <td class="lib">Library</td>
      <td class="english">English</td>
      <td class="cs">Programming</td>
    </tr>

    <!-- Friday -->
    <tr>
      <td class="row-label">Fri</td>
      <td class="chem">Chemistry</td>
      <td class="english">English</td>
      <td class="cs">Programming</td>
      <td class="maths">Maths</td>
      <td colspan="1" class="lab">Physics Lab</td>
    </tr>

    <!-- Saturday -->
    <tr>
      <td class="row-label">Sat</td>
      <td colspan="2" class="lab">DBMS Lab</td>
      <td class="pe">Physical Ed.</td>
      <td class="lib">Library</td>
      <td class="maths">Maths</td>
    </tr>
  </table>

</body>
</html>
